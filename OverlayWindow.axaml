<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="310" d:DesignHeight="196"
        x:Class="DiscordMultiTool.OverlayWindow"
        Title="DMT HUD"
        Width="310" Height="196"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        Icon="NEW LOGO.png">

  <Border x:Name="RootBorder"
          Background="#D90B0D13"
          CornerRadius="14"
          BorderBrush="#323B54"
          BorderThickness="1"
          Padding="16,14"
          BoxShadow="0 8 24 0 #66000000"
          PointerPressed="OnPointerPressed"
          PointerEntered="OnWindowPointerEnter"
          PointerExited="OnWindowPointerExit">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border CornerRadius="8" ClipToBounds="True" Width="28" Height="28" BorderBrush="#323B54" BorderThickness="1">
            <Image Source="NEW LOGO.png" Stretch="UniformToFill" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="TitleText" Text="DiscordMultiTool" FontWeight="Bold" FontSize="13.5" Foreground="White" />
            <TextBlock Text="LIVE HUD" FontSize="9.5" FontWeight="Bold" LetterSpacing="1" Foreground="#5865F2" />
          </StackPanel>
        </StackPanel>

        <Button x:Name="CloseButton"
                Grid.Column="1"
                Content="✕"
                Click="CloseOverlay"
                Foreground="#949BA4"
                Background="#1B2030"
                CornerRadius="6"
                BorderThickness="0"
                Width="24"
                Height="24"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="11"
                Cursor="Hand"
                Opacity="0">
          <Button.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
            </Transitions>
          </Button.Transitions>
        </Button>
      </Grid>

      <Border Grid.Row="1" Height="1" Background="#22283A" Margin="0,10,0,10" />

      <!-- Function Items -->
      <StackPanel Grid.Row="2" x:Name="FunctionContainer" Spacing="7" VerticalAlignment="Center">
        <TextBlock x:Name="DiscordBotText"
                   Text="○  Discord Bot · IDLE"
                   Foreground="#5E6778"
                   FontSize="12.5"
                   FontWeight="SemiBold">
          <TextBlock.Transitions>
            <Transitions>
              <DoubleTransition Property="FontSize" Duration="0:0:0.2" />
            </Transitions>
          </TextBlock.Transitions>
        </TextBlock>

        <TextBlock x:Name="TelegramBotText"
                   Text="○  Telegram Bot · IDLE"
                   Foreground="#5E6778"
                   FontSize="12.5"
                   FontWeight="SemiBold">
          <TextBlock.Transitions>
            <Transitions>
              <DoubleTransition Property="FontSize" Duration="0:0:0.2" />
            </Transitions>
          </TextBlock.Transitions>
        </TextBlock>

        <TextBlock x:Name="RichPresenceText"
                   Text="○  Rich Presence · IDLE"
                   Foreground="#5E6778"
                   FontSize="12.5"
                   FontWeight="SemiBold">
          <TextBlock.Transitions>
            <Transitions>
              <DoubleTransition Property="FontSize" Duration="0:0:0.2" />
            </Transitions>
          </TextBlock.Transitions>
        </TextBlock>
      </StackPanel>

      <!-- Footer -->
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
        <TextBlock Text="DRAG TO MOVE" FontSize="9" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="#475063" VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" Grid.Column="1" Text="v3.6.0" Foreground="#5E6778" FontSize="10" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
